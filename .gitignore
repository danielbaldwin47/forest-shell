# Pinterest pin images are copyrighted reference material - keep local only
.wayfinder/assets/pins/

# Python bytecode from tools/ scripts run in place
__pycache__/

# Agent workflow exhaust: per-ticket worktrees, plus scratch-log names as a
# cross-repo safety net (this repo's own noisy-output convention is mktemp
# in /tmp — see CLAUDE.md context discipline; never commit a log either way)
.claude/worktrees/
*.scratch.log

# Env files carry credentials; committed placeholders take the name *.env.example.
# (integration/shell-switch/registration.env is data, not credentials — tracked on purpose.)
.env
!integration/shell-switch/registration.env

# built by tools/nested-session.sh from tools/nested-click.c
tools/nested-click
